import threading
import time


class SharedState:
    def __init__(self):
        self.lock = threading.Lock()
        self.current_animation_target: str | None = None
        self.last_external_command_at: float | None = None

    def set_external_command(self, target: str):
        with self.lock:
            self.current_animation_target = target
            self.last_external_command_at = time.time()

    def is_external_active(self, cooldown_s: float = 2.0) -> bool:
        with self.lock:
            if self.last_external_command_at is None:
                return False
            return (time.time() - self.last_external_command_at) < cooldown_s