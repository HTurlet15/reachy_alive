# reachy_alive/shared_state.py
import threading
import time


class SharedState:
    """
    Central, thread-safe object shared across all cognitive modules
    (blackboard pattern). Modules never call each other directly —
    they only read/write this object.
    """

    def __init__(self):
        self.lock = threading.Lock()

        # Timestamp (from time.time()) of the last external command,
        # i.e. a reaction from Amygdala or an expression from the
        # Prefrontal Cortex. None means nothing external has happened yet.
        self.last_external_command_at: float | None = None

    def is_external_active(self, cooldown_s: float = 2.0) -> bool:
        """
        Check whether an external command happened recently enough
        that idle behaviors should not take over yet.

        Args:
            cooldown_s: how long, in seconds, an external command
                "occupies" the robot after it happened.

        Returns:
            True if idle_behaviors should skip this tick (something
            external is still considered active), False otherwise.
        """
        with self.lock:
            if self.last_external_command_at is None:
                return False
            return (time.time() - self.last_external_command_at) < cooldown_s